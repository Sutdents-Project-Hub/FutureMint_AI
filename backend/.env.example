# Copy to .env for local development. Coolify values belong in runtime variables.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
AI_PROVIDER=demo
DATA_PROVIDER=memory
ALLOW_DEMO_SEED=
DATABASE_URL=postgresql://futuremint:change-me@localhost:5432/futuremint
DATABASE_SSL=false
LIANGJIE_BASE_URL=https://liangjiewis.com/v1
LIANGJIE_MODEL=gemini-2.5-flash
LIANGJIE_API_KEY=
ALLOWED_ORIGINS=http://localhost:4173

# Only trust actual connecting proxy IP/CIDRs; empty ignores forwarding headers.
TRUSTED_PROXY_CIDRS=
# Optional mail. Without SMTP, registration/login work without email verification; mail actions stay disabled.
MAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=
SERVICE_OPERATOR=
SUPPORT_EMAIL=
# Empty values below use the versioned defaults in src/config/publicConfig.ts.
PRIVACY_POLICY_VERSION=
DATA_REGION=
BACKUP_RETENTION_DAYS=0
MINIMUM_AGE=15
MINOR_CONSENT_DISCLOSURE=
AI_DATA_TERMS_DISCLOSURE=
PRIVACY_POLICY_REVIEWED=false

# Official OpenAI is a manual server-side alternative; no automatic fallback.
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional overrides of src/config/providerPolicies.ts.
# Unreviewed/missing provider terms disable external AI, not API startup.
# reviewed=true means operator approval of the public disclosure, not verified upstream guarantees.
# Known data flows and unknown conditions must be explicit; see docs/deployment.md.
LIANGJIE_DATA_RECIPIENTS=
LIANGJIE_DATA_TERMS_DISCLOSURE=
LIANGJIE_DATA_TERMS_REVIEWED=false
OPENAI_DATA_RECIPIENTS=
OPENAI_DATA_TERMS_DISCLOSURE=
OPENAI_DATA_TERMS_REVIEWED=false
# One operation budget covers every retry and schema repair.
AI_OPERATION_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=300
AI_MAX_CONCURRENCY=5
