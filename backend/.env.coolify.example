# Coolify API only: Runtime enabled, Buildtime disabled.
# Fill real values in Coolify, never in this file.
# Web is not required for iPhone; PUBLIC_BASE_URL is the API HTTPS origin.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
AI_PROVIDER=liangjie
DATA_PROVIDER=postgres
DATABASE_URL=
DATABASE_SSL=false
LIANGJIE_MODEL=
LIANGJIE_API_KEY=
PUBLIC_BASE_URL=
SERVICE_OPERATOR=
SUPPORT_EMAIL=
DATA_REGION=
# Confirm the generated public policy before changing to true.
PRIVACY_POLICY_REVIEWED=false
MAIL_PROVIDER=disabled

# Defaults: no scheduled backups, age 15, API origin CORS, bounded AI usage.
# SMTP and provider DATA_* overrides are optional; see .env.example.
# Without SMTP: registration/login without email verification; no mailed reset/guardian confirmation.
# Without reviewed provider terms: manual features only; no external AI.
