# Local Docker Compose overrides. Do not put API keys or database passwords here.
WEB_PORT=14173
API_PORT=13000
WEB_ORIGIN=http://localhost:14173
PUBLIC_API_BASE_URL=http://localhost:13000/api/

# Optional local Liangjie integration. Keep AI_PROVIDER=demo for an offline,
# repeatable demo. LIANGJIE_API_KEY stays blank in this example and belongs only
# in the ignored local .env file.
AI_PROVIDER=demo
DATA_PROVIDER=postgres
LIANGJIE_BASE_URL=https://liangjiewis.com/v1
LIANGJIE_MODEL=gemini-2.5-flash
LIANGJIE_API_KEY=
